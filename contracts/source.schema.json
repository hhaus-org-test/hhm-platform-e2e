    "repository": { "const": "hhm-pub-lib-core" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generatorRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}

